#!/bin/bash
# Shim: fev.sh hardcodes `timeout 120s` calibrated for a faster machine.
# Replace that budget with MM_FEV_TIMEOUT seconds (default 3600, set by the
# router); pass everything else through.
budget="${MM_FEV_TIMEOUT:-3600}s"
args=()
for a in "$@"; do
  [[ "$a" == "120s" ]] && a="$budget"
  args+=("$a")
done
exec /usr/bin/timeout "${args[@]}"
